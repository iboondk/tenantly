# Copy to .env and replace every placeholder. Never commit real secrets.
APP_ENV=dev
HTTP_ADDR=:8080
DATABASE_URL=postgres://tenantly_app:changeme@localhost:5432/tenantly?sslmode=disable
MIGRATE_DATABASE_URL=postgres://postgres:changeme@localhost:5432/tenantly?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-32+-random-bytes
JWT_TTL=1h
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTH_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=
OAUTH_REDIRECT_URL=http://localhost:8080/v1/auth/oauth/callback
RATE_LIMIT_PER_MINUTE=120
CACHE_TTL=30s
OTEL_EXPORTER=stdout
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Used by docker-compose and deploy/postgres/init only.
POSTGRES_PASSWORD=changeme
APP_DB_PASSWORD=changeme
